# LLM provider: "ollama" (local, default) or "watsonx"
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=granite4:micro

# Only needed when LLM_PROVIDER=watsonx
WATSONX_API_KEY=insert_key_here
WATSONX_PROJECT_ID=insert_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-3-8b-instruct
