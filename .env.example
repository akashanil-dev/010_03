# ---------- AI model ----------
# LLM provider: "ollama" (local, default) or "watsonx"
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=granite4:micro

# Only needed when LLM_PROVIDER=watsonx
WATSONX_API_KEY=insert_key_here
WATSONX_PROJECT_ID=insert_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-3-8b-instruct

# ---------- Public site ----------
# The address people use. Links in emails point here; https:// turns on secure cookies.
PUBLIC_URL=http://localhost:8000
CONTACT_EMAIL=privacy@akashanil.dev

# ---------- Limits ----------
# checks per account per day (demos do not count); resets at midnight in QUOTA_TIMEZONE
DAILY_SHIPMENTS=5
# checks one account can have running or waiting at once
MAX_ACTIVE_PER_USER=3
# seconds before one document is stopped
DOC_TIMEOUT=300
# seconds before a whole running check is stopped
SHIPMENT_TIMEOUT=1800
# seconds a check may wait in the queue before it is cancelled
QUEUE_TIMEOUT=7200
# refuse new checks while more than this many seconds of work are waiting
BUSY_BACKLOG=7200
QUOTA_TIMEZONE=Asia/Kolkata
# uploads, results, reviews and the audit log are deleted after this
RETENTION_DAYS=7

# ---------- Email (SMTP relay: Oracle Cloud Email Delivery, see DEPLOY.md) ----------
# Leave SMTP_HOST empty in development: emails (with their links) are printed to the web app's log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=TallyTime <no-reply@akashanil.dev>

# ---------- Cloudflare Turnstile bot check (sign-up and password reset) ----------
# Leave empty to skip the check (development).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ---------- Browser push notifications ----------
# Generate with: python -m app.notify keys   (setup.sh does this on the server)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:privacy@akashanil.dev
